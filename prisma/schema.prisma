generator client {
  provider      = "prisma-client-js"
  url           = env("DATABASE_URL")
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                          String               @id @default(cuid())
  username                    String               @unique
  password                    String
  created_at                  DateTime             @default(now())
  updated_at                  DateTime             @updatedAt
  is_verified                 Boolean              @default(false)
  email                       String               @unique
  auth_magic_tokens           Auth_Magic_Token[]
  auth_sessions               Auth_Session[]
  invite_magic_tokens_created Invite_Magic_Token[] @relation("InviteCreatedTokens")
  invite_magic_tokens         Invite_Magic_Token[] @relation("InviteRecipientTokens")
  recruiter                   Recruiter?
  student                     Student?
  teacher                     Teacher?
  tnp                         Tnp?
  internships                 Internship[]
}

model Temp {
  id String @id @default(cuid())
}

model Auth_Magic_Token {
  id         String    @id @default(cuid())
  user_id    String
  token_hash String    @unique
  jti        String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Invite_Magic_Token {
  id                 String    @id @default(cuid())
  user_id            String
  recipient_email    String
  created_by_user_id String?
  custom_message     String?
  token_hash         String    @unique
  jti                String    @unique
  expires_at         DateTime
  used_at            DateTime?
  created_at         DateTime  @default(now())
  target_role        String    @default("recruiter")
  created_by         User?     @relation("InviteCreatedTokens", fields: [created_by_user_id], references: [id])
  user               User      @relation("InviteRecipientTokens", fields: [user_id], references: [id], onDelete: Cascade)
}

model Auth_Session {
  id                 String    @id @default(cuid())
  user_id            String
  refresh_token_hash String    @unique
  jti                String    @unique
  expires_at         DateTime
  revoked_at         DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Student {
  registration_number    String                      @id
  prn_number             String?                     @unique
  user_id                String                      @unique
  te_roll_number         String?
  be_roll_number         String?
  cgpa                   Float
  first_name             String?
  middle_name            String?
  last_name              String?
  date_of_birth          DateTime                    @db.Date
  gender                 Gender?
  primary_email          String                      @unique
  secondary_email        String?
  student_email          String?
  primary_phone          String?                     @unique
  secondary_phone        String?
  current_address        Json?
  permanent_address      Json?
  batch                  Int?
  department             String?
  x_class                Decimal?
  x_class_board          String?
  x_class_passing_year   Int?
  x_gap_year             Int?                        @default(0)
  x_gap_reason           String?
  xii_class              Decimal?
  xii_class_board        String?
  xii_class_passing_year Int?
  xii_gap_year           Int?                        @default(0)
  xii_gap_reason         String?
  diploma                Decimal?
  diploma_university     String?
  diploma_passing_year   Int?
  diploma_gap_year       Int?                        @default(0)
  diploma_gap_reason     String?
  cet_percentile         Decimal?
  jee_percentile         Decimal?
  amcat_marks            Decimal?
  amcat_details          Json?
  active_backlog         Int                         @default(0)
  active_backlog_sem     String?
  passive_backlog        Int                         @default(0)
  yd                     Boolean                     @default(false)
  aadhar_number          String?
  pan_number             String?
  passport               String?
  citizenship            String?
  higher_education_plans Boolean                     @default(false)
  te_fee_link            String?
  be_fee_link            String?
  created_at             DateTime                    @default(now())
  updated_at             DateTime                    @updatedAt
  skills                 String[]
  isPlaced               Boolean                     @default(false)
  documents              Document[]
  drive_responses        Drive_Response[]
  received_invitations   Group_Invitation[]          @relation("ReceivedInvitations")
  sent_invitations       Group_Invitation[]          @relation("SentInvitations")
  internshipApplications InternshipApplication[]
  notifications          Notifications[]
  user                   User                        @relation(fields: [user_id], references: [id])
  student_groups         Student_Group_Association[]
}

model Teacher {
  id                     String        @id @default(cuid())
  user_id                String        @unique
  first_name             String
  last_name              String
  email                  String        @unique
  phone                  String        @unique
  department             String
  is_active              Boolean       @default(true)
  created_at             DateTime      @default(now())
  updated_at             DateTime      @updatedAt
  supervised_projects    Project[]
  user                   User          @relation(fields: [user_id], references: [id])
  assigned_teacher_roles TeacherRole[] @relation("AssignedBy")
  teacher_roles          TeacherRole[]
}

model Tnp {
  id         String   @id @default(cuid())
  user_id    String   @unique
  first_name String
  last_name  String
  email      String   @unique
  phone      String?  @unique
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id])
}

model Recruiter {
  id           String   @id @default(cuid())
  user_id      String   @unique
  first_name   String
  last_name    String
  email        String   @unique
  phone        String?  @unique
  company_name String?
  designation  String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  user         User     @relation(fields: [user_id], references: [id])
}

model Skill {
  id             String                      @id @default(cuid())
  name           String                      @unique
  student_skills Student_Skill_Association[]
}

model Student_Skill_Association {
  student_registration_number String
  skill_id                    String
  skill                       Skill  @relation(fields: [skill_id], references: [id])

  @@id([student_registration_number, skill_id])
}

model Document {
  id                          String   @id @default(cuid())
  student_registration_number String
  name                        String?
  document_description        Json
  document_url                String
  created_at                  DateTime @default(now())
  skills                      String[] @default([])
  student                     Student  @relation(fields: [student_registration_number], references: [registration_number])
}

model Company_Drive {
  drive_id              String           @id @default(uuid())
  company_name          String
  min_cgpa              Float
  registration_deadline DateTime
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt
  responses             Drive_Response[]

  @@map("CompanyDrive")
}

model Drive_Response {
  response_id          String        @id @default(uuid())
  student_id           String
  drive_id             String
  is_interested        Boolean?      @default(false)
  responded_at         DateTime?
  created_at           DateTime      @default(now())
  email_token_hash     String?
  token_expires_at     DateTime?
  notification_sent_at DateTime?
  drive                Company_Drive @relation(fields: [drive_id], references: [drive_id])
  student              Student       @relation(fields: [student_id], references: [registration_number])

  @@unique([student_id, drive_id])
  @@map("DriveResponse")
}

model Notifications {
  id         String   @id @default(cuid())
  student_id String
  message    String
  created_at DateTime @default(now())
  student    Student  @relation(fields: [student_id], references: [registration_number])
}

model Project {
  title                 String
  description           String
  technology_stack      String
  academic_year         String
  repo_url              String?                     @unique
  current_phase_id      Int?
  supervisor_id         String?
  project_id            Int                         @id @default(autoincrement())
  min_cgpa              Float?
  registration_deadline DateTime?
  supervisor            Teacher?                    @relation(fields: [supervisor_id], references: [id])
  groups                Project_Group_Association[]
  phases                Project_Phase[]
  git_logs              Git_logbook_entries[]

  @@map("Project")
}

model TeacherRole {
  teacher_id     String
  role_id        String
  assigned_by_id String?
  assigned_at    DateTime @default(now())
  assigned_by    Teacher? @relation("AssignedBy", fields: [assigned_by_id], references: [id])
  role           Role     @relation(fields: [role_id], references: [id])
  teacher        Teacher  @relation(fields: [teacher_id], references: [id])

  @@id([teacher_id, role_id])
}

model Group {
  group_name  String?
  group_id    Int                         @id @default(autoincrement())
  invitations Group_Invitation[]
  teachers    Group_Teacher_Association[]
  projects    Project_Group_Association[]
  students    Student_Group_Association[]

  @@map("Group")
}

model Group_Invitation {
  id          Int      @id @default(autoincrement())
  group_id    Int
  sender_id   String
  receiver_id String
  status      String   @default("PENDING")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  description String?
  group       Group    @relation(fields: [group_id], references: [group_id])
  receiver    Student  @relation("ReceivedInvitations", fields: [receiver_id], references: [registration_number])
  sender      Student  @relation("SentInvitations", fields: [sender_id], references: [registration_number])

  @@map("Group_Invitation")
}

model Project_Group_Association {
  project_id Int
  group_id   Int
  group      Group   @relation(fields: [group_id], references: [group_id])
  project    Project @relation(fields: [project_id], references: [project_id])

  @@id([project_id, group_id])
  @@map("Project_Group_Association")
}

model Project_Phase {
  phase_id          Int          @default(autoincrement())
  phase_name        String
  phase_description String
  start_date        DateTime     @db.Date
  end_date          DateTime     @db.Date
  status            Phase_Status @default(OPEN)
  comments          String?
  project_id        Int
  project           Project      @relation(fields: [project_id], references: [project_id], onDelete: Cascade)

  @@id([phase_id, project_id])
  @@map("Project_Phase")
}

model Student_Group_Association {
  student_id String
  group_id   Int
  group      Group   @relation(fields: [group_id], references: [group_id])
  student    Student @relation(fields: [student_id], references: [registration_number])

  @@id([student_id, group_id])
  @@map("Student_Group_Association")
}

model Group_Teacher_Association {
  teacher_id String
  group_id   Int
  group      Group  @relation(fields: [group_id], references: [group_id])

  @@id([teacher_id, group_id])
  @@map("Group_Teacher_Association")
}

model Git_logbook_entries {
  id                   String   @id @default(uuid())
  commit_id            String   @unique
  commit_message       String
  files_changed        Int      @default(0)
  difficulty_of_commit Int      @default(1)
  commit_timestamp     DateTime
  received_at          DateTime @default(now())
  anomaly_reason       String?
  is_anomaly           Boolean  @default(false)
  pusher_name          String
  project_id           Int
  project              Project  @relation(fields: [project_id], references: [project_id])

  @@map("git_logbook_entries")
}

model Role {
  id               String           @id @default(cuid())
  name             String
  description      String
  role_permissions RolePermission[]
  teacher_roles    TeacherRole[]
}

model Permission {
  id               String           @id @default(cuid())
  name             String
  description      String?
  role_permissions RolePermission[]
}

model RolePermission {
  role_id       String
  permission_id String
  permission    Permission @relation(fields: [permission_id], references: [id])
  role          Role       @relation(fields: [role_id], references: [id])

  @@id([role_id, permission_id])
}

model Logs {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  identifier String?
  type       String   @default("INFO")
  source     String?
  data       Json

  @@map("Logs")
}

model Internship {
  id           String                  @id @default(cuid())
  title        String
  company      String
  description  String
  stipend      String?
  duration     String?
  skills       String[]
  tags         String[]
  min_cgpa     Float?
  departments  String[]
  years        Int[]
  posted_by    String
  posted_date  DateTime                @default(now())
  deadline     DateTime
  applicants   Int                     @default(0)
  created_at   DateTime                @default(now())
  updated_at   DateTime                @updatedAt
  postedBy     User                    @relation(fields: [posted_by], references: [id])
  applications InternshipApplication[]

  @@map("Internship")
}

model InternshipApplication {
  id           String     @id @default(uuid())
  studentId    String
  internshipId String
  status       String     @default("APPLIED")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  internship   Internship @relation(fields: [internshipId], references: [id])
  student      Student    @relation(fields: [studentId], references: [registration_number])
}

enum Phase_Status {
  OPEN
  CLOSED
  LOCKED
  SUBMITTED
}

enum Gender {
  Male
  Female
  Other
}